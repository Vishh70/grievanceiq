# ==============================================================================
# GrievanceIQ Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your credentials.
#
# ENVIRONMENT SEPARATION GUIDE:
# -----------------------------
# - In BOTH Production and Staging, set NODE_ENV=production. This ensures
#   production optimizations, secure cookie flags, and disabled stack traces.
# - Differentiate the environments using APP_ENV:
#     * APP_ENV=production : Restricts CORS to official production Vercel domains
#                            (grievanceiq-app.vercel.app, grievanceiq-ten.vercel.app)
#                            plus any explicitly listed CLIENT_URL/ALLOWED_ORIGINS.
#     * APP_ENV=staging    : CORS allows ONLY explicitly configured staging origins
#                            (CLIENT_URL / ALLOWED_ORIGINS). Production domains are rejected.
#                            Health endpoint reports `environment: staging`.
#     * APP_ENV=development: CORS allows local Vite ports (localhost:5173, 127.0.0.1:5173).
# ==============================================================================

PORT=5000
NODE_ENV=development
APP_ENV=development

# ── Cross-Origin Resource Sharing (CORS) ──────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes, no wildcards)
# In Staging: Set this to your exact Vercel Preview domain (e.g. https://staging-preview.vercel.app)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=

# ── Supabase Database & Auth ──────────────────────────────────────────────────
# Staging MUST use a dedicated, isolated Supabase project. Never share credentials with production.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Security & Authentication ────────────────────────────────────────────────
# Minimum 32 characters high-entropy random string
JWT_SECRET=replace_with_a_long_random_secret_string_at_least_32_chars
ADMIN_PASSWORD=your_secure_admin_seed_password_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# ── Redis / BullMQ Queue ─────────────────────────────────────────────────────
# Staging MUST use an isolated Redis instance (e.g. Upstash direct redis:// connection)
REDIS_URL=redis://localhost:6379

# ── AI Services (Gemini API) ─────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_RETRIES=1

# ── Python ML Inference Service ───────────────────────────────────────────────
# When ML_SERVICE_URL is localhost or unset, the backend supervises the local Python process.
# When set to an external URL (e.g. separate container), local supervisor spawn is skipped.
ML_SERVICE_URL=http://127.0.0.1:5001
ML_SERVICE_SECRET=your_ml_service_internal_secret_here
