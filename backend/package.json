{
  "name": "grievanceiq-backend",
  "version": "1.0.0",
  "description": "GrievanceIQ - AI-Powered Citizen Complaint Intelligence Platform Backend",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --detectOpenHandles --forceExit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration/ --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/endToEnd.test.js",
    "demo": "node scripts/seedDemoData.js",
    "demo:reset": "node scripts/seedDemoData.js --reset"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.117.2",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.2",
    "ml-random-forest": "^2.1.0",
    "multer": "^1.4.5-lts.1",
    "papaparse": "^5.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.3",
    "supertest": "^7.2.2"
  }
}
